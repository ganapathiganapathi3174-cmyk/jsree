# =====================================================
# ReferralHub Client - Environment Variables
# Copy this file to .env and fill in real values
# Only VITE_* variables are exposed to the browser
# =====================================================

# ---- API ----
# Production (Vercel): set to your deployed backend URL, e.g. https://your-backend.com/api
# Local dev: uncomment the line below
VITE_API_URL=http://localhost:5000/api

# ---- Supabase (public anon key only) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
