# =====================================================
# ReferralHub Server - Environment Variables
# Copy this file to .env and fill in real values
# =====================================================

# ---- Supabase (REQUIRED) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- JWT (REQUIRED) ----
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ---- Admin (REQUIRED) ----
ADMIN_EMAIL=admin@gmail.com
# Generate hash: node -e "require('bcryptjs').hash('your-password', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=your-bcrypt-hash-of-admin-password

# ---- UPI ----
ADMIN_UPI_ID=jayarajj126-3@okicici
# Receiver (payee) name checked by the OCR name gate. REQUIRED for approvals:
# with no name configured every proof fails safe to RECEIVER_NAME_NOT_CONFIGURED.
ADMIN_RECEIVER_NAME=Your Receiver Name
# Straight-through auto-approval of engine-approved screenshots.
# Keep false/unset in production: OCR-approved proofs then park as
# manual_review (EXTERNAL_PAYMENT_CONFIRMATION_REQUIRED) for human confirmation.
PAYMENT_AUTO_APPROVE=false

# ---- Direct DB (migration scripts only; the running server uses Supabase keys above) ----
# Used only by server/src/scripts/apply-migrations-*.mjs. Do NOT run migrations for this migration.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ---- Server ----
# PORT must stay 5000 inside the OCI container (Caddy reverse-proxies to api:5000).
# On OCI, NODE_ENV=production. Copy the production values from Railway; never commit .env.
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS. Comma-separated list allowed.
# Production (Railway, now OCI) MUST include your Vercel domain, e.g.:
# CLIENT_URL=https://jsree.vercel.app,http://localhost:5173
# On OCI set CLIENT_URL to the production frontend only (plus localhost for debugging):
# CLIENT_URL=https://jsree.vercel.app
CLIENT_URL=http://localhost:5173
