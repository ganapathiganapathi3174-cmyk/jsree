# =====================================================
# ReferralHub Server - Environment Variables
# Copy this file to .env and fill in real values
# =====================================================

# ---- Supabase (REQUIRED) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- JWT (REQUIRED) ----
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ---- Admin (REQUIRED) ----
ADMIN_EMAIL=admin@gmail.com
# Generate hash: node -e "require('bcryptjs').hash('your-password', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=your-bcrypt-hash-of-admin-password

# ---- UPI ----
ADMIN_UPI_ID=jayarajj126-3@okicici

# ---- Server ----
PORT=5000
NODE_ENV=development
# Frontend origin allowed by CORS (set to your Vercel domain in production, e.g. https://jsree.vercel.app)
CLIENT_URL=http://localhost:5173
