# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Admin
ADMIN_EMAIL=admin@gmail.com
# Generate hash: node -e "require('bcryptjs').hash('your-password', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=your-bcrypt-hash-of-admin-password

# UPI
ADMIN_UPI_ID=jayarajj126-3@okicici
# Receiver (payee) name checked by the OCR secondary name gate.
# Recommended: when set, a payee-name mismatch rejects automatically.
# When empty the secondary gate is skipped (receiver UPI + amount +
# date + integrity + duplicate gates remain mandatory).
ADMIN_RECEIVER_NAME=Your Receiver Name

# Deterministic approval policy (no switch required):
#   * all mandatory screenshot gates pass -> APPROVED automatically
#   * definite verification failure       -> REJECTED automatically
#   * technical failure (OCR/provider)    -> retryable no-decision (never
#     fraud, never an approval; row stays resubmittable)

# Sender (payer) name policy — off | reject (default) | review.
# reject (default): a complete payer-name mismatch is a definitive rejection.
# review: operator opt-in — a payer-name mismatch routes to MANUAL_REVIEW.
# An unreadable/partial sender line is always advisory and never blocks.
SENDER_NAME_POLICY=reject

# Payment-provider verification (independent confirmation of the transaction).
# none  (default): no provider configured — the mandatory screenshot checks
#                  are the verification policy; fully verified screenshots
#                  are APPROVED automatically. LIMITATION: a screenshot
#                  alone cannot conclusively prove bank settlement.
# mock  : development/test-only simulated provider (REFUSED in production).
# live  : real HTTP verification against PAYMENT_PROVIDER_VERIFY_URL;
#         definitive negatives reject automatically, technical failures
#         fail safe to a retryable no-decision.
PAYMENT_PROVIDER_MODE=none
PAYMENT_PROVIDER_VERIFY_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_TIMEOUT_MS=8000
# Dev-only: simulate a provider timeout (mock mode).
PAYMENT_PROVIDER_MOCK_TIMEOUT=false

# OCR tuning (optional)
# PAYMENT_TIME_WINDOW_MINUTES=30
# MIN_OCR_CONFIDENCE_APPROVE=55
# NORMALIZE_UTRS_FOR_DUPLICATE=false
# OCR_VERIFICATION_BUDGET_MS=120000
# OCR_AMOUNT_RECOVERY_BUDGET_MS=60000
# OCR_RECOVERY_STAGE_BUDGET_MS=25000

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
