# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Admin
ADMIN_EMAIL=admin@gmail.com
# Generate hash: node -e "require('bcryptjs').hash('your-password', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=your-bcrypt-hash-of-admin-password

# UPI
ADMIN_UPI_ID=jayarajj126-3@okicici
# Receiver (payee) name checked by the OCR name gate. REQUIRED for approvals:
# with no name configured every proof fails safe to RECEIVER_NAME_NOT_CONFIGURED.
ADMIN_RECEIVER_NAME=Your Receiver Name
# Straight-through auto-approval of engine-approved screenshots.
# Keep false/unset in production: OCR-approved proofs then park as
# manual_review (EXTERNAL_PAYMENT_CONFIRMATION_REQUIRED) for human confirmation.
PAYMENT_AUTO_APPROVE=false

# Sender (payer) name policy — off | review (default) | reject.
# review: a complete payer-name mismatch routes the payment to MANUAL_REVIEW.
# reject: a payer-name mismatch is a definitive rejection.
# An unreadable/partial sender line is always advisory and never blocks.
SENDER_NAME_POLICY=review

# Payment-provider verification (independent confirmation of the transaction).
# none  (default): no provider configured — engine-approved proofs stay
#                  PENDING_VERIFICATION / manual review (never auto-settled).
# mock  : development/test-only simulated provider (REFUSED in production).
# live  : real HTTP verification against PAYMENT_PROVIDER_VERIFY_URL.
PAYMENT_PROVIDER_MODE=none
PAYMENT_PROVIDER_VERIFY_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_TIMEOUT_MS=8000
# Dev-only: simulate a provider timeout (mock mode).
PAYMENT_PROVIDER_MOCK_TIMEOUT=false

# OCR tuning (optional)
# PAYMENT_TIME_WINDOW_MINUTES=30
# MIN_OCR_CONFIDENCE_APPROVE=55
# NORMALIZE_UTRS_FOR_DUPLICATE=false
# OCR_VERIFICATION_BUDGET_MS=120000
# OCR_AMOUNT_RECOVERY_BUDGET_MS=60000
# OCR_RECOVERY_STAGE_BUDGET_MS=25000

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
