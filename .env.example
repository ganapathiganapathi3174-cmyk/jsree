# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Admin
ADMIN_EMAIL=admin@gmail.com
# Generate hash: node -e "require('bcryptjs').hash('your-password', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=your-bcrypt-hash-of-admin-password

# UPI
ADMIN_UPI_ID=jayarajj126-3@okicici
# Receiver (payee) name checked by the OCR name gate. REQUIRED for approvals:
# with no name configured every proof fails safe to RECEIVER_NAME_NOT_CONFIGURED.
ADMIN_RECEIVER_NAME=Your Receiver Name
# Straight-through auto-approval of engine-approved screenshots.
# Keep false/unset in production: OCR-approved proofs then park as
# manual_review (EXTERNAL_PAYMENT_CONFIRMATION_REQUIRED) for human confirmation.
PAYMENT_AUTO_APPROVE=false

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
